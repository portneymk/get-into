# Optional. Falls back to content/_config.json (claypool).
NEXT_PUBLIC_DEFAULT_PACK=claypool

# GitHub Pages project site. The deploy workflow sets GITHUB_PAGES=true
# (basePath + assetPrefix = /get-into). Leave unset for local /.
# For a custom domain later, set NEXT_PUBLIC_BASE_PATH= (empty) in the workflow.
# GITHUB_PAGES=true
# NEXT_PUBLIC_BASE_PATH=/get-into

# Optional. The site ships without this — why-next is checked-in / fallback text.
# OPENAI_API_KEY=
# WHY_NEXT_API_KEY=
